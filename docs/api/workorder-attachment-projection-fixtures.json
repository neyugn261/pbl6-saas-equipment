      "responseHeaders": { "Cache-Control": "no-store" },
      "body": { "downloadUrl": "https://storage.example.invalid/temporary-ticket", "expiresAt": "2026-11-01T00:01:00.000Z" },
      "srHandling": "Return no-store, never persist/cache/log this capability. Client uses storage GET without the API JWT."
    },
    {
