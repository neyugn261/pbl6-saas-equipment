      "responseHeaders": { "Cache-Control": "no-store" },
      "body": {
        "items": [
          { "id": "30000000-0000-4000-8000-000000000001", "fileName": "equipment-before.pdf", "mimeType": "application/pdf", "sizeBytes": 512, "createdAt": "2026-11-01T00:00:01.000Z" },
          { "id": "30000000-0000-4000-8000-000000000002", "fileName": "service-result.png", "mimeType": "image/png", "sizeBytes": 2048, "createdAt": "2026-11-01T00:00:02.000Z" }
        ],
        "page": 1,
        "pageSize": 20,
        "total": 2
      }
    },
    {
