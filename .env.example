ASSET_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/asset_db

MAINTENANCE_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/maintenance_db

WORKORDER_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/workorder_db

NOTIFICATION_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/notification_db


# ==============================
# RabbitMQ
# ==============================

RABBITMQ_URL=amqp://pbl6:pbl6_dev_password@localhost:5672


# ==============================
# Redis
# ==============================

REDIS_URL=redis://localhost:6379


# ==============================
# MinIO
# ==============================

