# ==============================
# Application
# ==============================

NODE_ENV=development

API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
ASSET_SERVICE_PORT=3002
MAINTENANCE_SERVICE_PORT=3003
WORKORDER_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005
ORGANIZATION_SERVICE_PORT=3006
SERVICE_REQUEST_SERVICE_PORT=3007
INVENTORY_SERVICE_PORT=3008

# ==============================
# PostgreSQL
# ==============================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pbl6
POSTGRES_PASSWORD=pbl6_dev_password

IDENTITY_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/identity_db
# Empty scratch database for `prisma migrate dev` and `db:check-drift` (required by the drift check).
IDENTITY_SHADOW_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/identity_shadow_db
# e2e tests only; the database name must contain "test" (the suite truncates tables).
IDENTITY_TEST_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/identity_test_db

ORGANIZATION_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/organization_db

ASSET_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/asset_db

SERVICE_REQUEST_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/service_request_db

MAINTENANCE_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/maintenance_db

WORKORDER_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/workorder_db

INVENTORY_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/inventory_db

NOTIFICATION_DATABASE_URL=postgresql://pbl6:pbl6_dev_password@localhost:5432/notification_db


# ==============================
# RabbitMQ
# ==============================

RABBITMQ_URL=amqp://pbl6:pbl6_dev_password@localhost:5672


# ==============================
# Redis
# ==============================

REDIS_URL=redis://localhost:6379


# ==============================
# MinIO
# ==============================

MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=pbl6
MINIO_SECRET_KEY=pbl6_minio_password


# ==============================
# Identity Service — tokens and passwords
# ==============================

# Random value of at least 32 characters, e.g. `openssl rand -hex 32`.
# The service refuses to start with CHANGE_ME or a short secret.
JWT_ACCESS_SECRET=CHANGE_ME
JWT_ISSUER=pbl6-identity
JWT_AUDIENCE=pbl6
# Access token lifetime in seconds (60-3600).
JWT_ACCESS_TTL_SECONDS=900
# Absolute refresh-session lifetime from login, in days. Refresh tokens are
# opaque random strings stored as SHA-256 hashes (no JWT refresh secret).
REFRESH_TOKEN_TTL_DAYS=7
# bcrypt work factor (10-15; tests may use 4).
BCRYPT_COST=12

# Password of the demo accounts created by `pnpm identity:seed:dev` (dev only).
SEED_DEMO_PASSWORD=CHANGE_ME_demo123