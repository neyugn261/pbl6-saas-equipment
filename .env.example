# ==============================
# Application
# ==============================

NODE_ENV=development

API_GATEWAY_PORT=3000
IDENTITY_SERVICE_PORT=3001
ASSET_SERVICE_PORT=3002
MAINTENANCE_SERVICE_PORT=3003
WORKORDER_SERVICE_PORT=3004
NOTIFICATION_SERVICE_PORT=3005

# ==============================
# PostgreSQL
# ==============================

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=pbl6
POSTGRES_PASSWORD=pbl6_dev_password

