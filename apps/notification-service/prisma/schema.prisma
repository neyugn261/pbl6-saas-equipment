// Notification Service — notification_db
//
// Source of truth for the table structure is prisma/migrations/0001_init
// (copied from docs/erd/pbl6-schema-v3.1.sql). This file mirrors it for the
// Prisma Client. Partial indexes and CHECK constraints live only in the
// migration; see prisma/README.md before changing anything here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// channel: IN_APP | EMAIL | PUSH. status (delivery): PENDING | SENT | FAILED.
/// read_at is only allowed for IN_APP (CHECK in SQL). (source_event_id,
/// user_id, channel) is unique when source_event_id is set (partial unique in
/// SQL), so a replayed event never notifies twice.
model Notification {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// NULL may represent a platform-level notification.
  tenantId      String?   @map("tenant_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  userId        String    @map("user_id") @db.Uuid
  /// Creation-time customer context; required by policy for CUSTOMER rows.
  customerId    String?   @map("customer_id") @db.Uuid
  sourceEventId String?   @map("source_event_id") @db.Uuid
  type          String    @db.VarChar(50)
  title         String    @db.VarChar(200)
  content       String
  payload       Json?
  channel       String    @db.VarChar(20)
  status        String    @default("PENDING") @db.VarChar(20)
  createdAt     DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt        DateTime? @map("sent_at") @db.Timestamptz(6)
  readAt        DateTime? @map("read_at") @db.Timestamptz(6)

  @@index([tenantId, type, createdAt(sort: Desc)], map: "idx_notifications_tenant_type")
  @@map("notifications")
}

/// Local eligibility projection from Identity recipient snapshots.
model RecipientSnapshot {
  userId                    String    @id @map("user_id") @db.Uuid
  tenantId                  String    @map("tenant_id") @db.Uuid
  userType                  String    @map("user_type") @db.VarChar(20)
  accountStatus             String    @map("account_status") @db.VarChar(30)
  roleCodes                 Json      @map("role_codes")
  membershipId              String?   @map("membership_id") @db.Uuid
  customerId                String?   @map("customer_id") @db.Uuid
  membershipStatus          String?   @map("membership_status") @db.VarChar(20)
  membershipSourceChangedAt DateTime? @map("membership_source_changed_at") @db.Timestamptz(6)
  revision                  BigInt
  bootstrapRunId            String?   @map("bootstrap_run_id") @db.Uuid
  sourceOccurredAt          DateTime  @map("source_occurred_at") @db.Timestamptz(6)
  updatedAt                 DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([tenantId, accountStatus, userType], map: "idx_recipient_snapshots_tenant_status")
  @@map("recipient_snapshots")
}

model RecipientBootstrapRun {
  bootstrapRunId String                      @id @map("bootstrap_run_id") @db.Uuid
  tenantId       String                      @map("tenant_id") @db.Uuid
  expectedUsers  Int?                        @map("expected_users")
  receivedUsers  Int                         @default(0) @map("received_users")
  markerReceived Boolean                     @default(false) @map("marker_received")
  status         String                      @default("RUNNING") @db.VarChar(20)
  startedAt      DateTime?                   @map("started_at") @db.Timestamptz(6)
  completedAt    DateTime?                   @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  receipts       RecipientBootstrapReceipt[]

  @@index([tenantId, status, createdAt(sort: Desc)], map: "idx_recipient_bootstrap_runs_tenant_status")
  @@unique([bootstrapRunId, tenantId], map: "uq_recipient_bootstrap_runs_id_tenant")
  @@map("recipient_bootstrap_runs")
}

model RecipientBootstrapReceipt {
  bootstrapRunId  String                @map("bootstrap_run_id") @db.Uuid
  userId          String                @map("user_id") @db.Uuid
  tenantId        String                @map("tenant_id") @db.Uuid
  appliedRevision BigInt                @map("applied_revision")
  receivedAt      DateTime              @default(now()) @map("received_at") @db.Timestamptz(6)
  run             RecipientBootstrapRun @relation(fields: [bootstrapRunId, tenantId], references: [bootstrapRunId, tenantId], onDelete: Cascade, onUpdate: NoAction)

  @@id([bootstrapRunId, userId])
  @@index([tenantId, userId], map: "idx_recipient_bootstrap_receipts_tenant_user")
  @@map("recipient_bootstrap_receipts")
}

model PendingNotificationEvent {
  sourceEventId     String                        @map("source_event_id") @db.Uuid
  consumer          String                        @db.VarChar(100)
  tenantId          String                        @map("tenant_id") @db.Uuid
  eventType         String                        @map("event_type") @db.VarChar(100)
  eventVersion      Int                           @map("event_version")
  payload           Json
  payloadSha256     String                        @map("payload_sha256") @db.Char(64)
  status            String                        @default("PENDING") @db.VarChar(20)
  reason            String                        @db.VarChar(80)
  attempts          Int                           @default(0)
  nextAttemptAt     DateTime                      @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCategory String?                       @map("last_error_category") @db.VarChar(80)
  leaseUntil        DateTime?                     @map("lease_until") @db.Timestamptz(6)
  createdAt         DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                      @default(now()) @map("updated_at") @db.Timestamptz(6)
  resolvedAt        DateTime?                     @map("resolved_at") @db.Timestamptz(6)
  deliveries        PendingNotificationDelivery[]

  @@id([sourceEventId, consumer])
  @@map("pending_notification_events")
}

/// Local projection of Service Request fields needed for notification routing.
/// It deliberately stores no title, description, comments, or attachment data.
model ServiceRequestSnapshot {
  tenantId              String   @map("tenant_id") @db.Uuid
  serviceRequestId      String   @map("service_request_id") @db.Uuid
  requestNo             String   @map("request_no") @db.VarChar(50)
  customerId            String   @map("customer_id") @db.Uuid
  requesterId           String   @map("requester_id") @db.Uuid
  requestType           String   @map("request_type") @db.VarChar(30)
  priority              String   @db.VarChar(20)
  status                String   @db.VarChar(40)
  createdEventId        String   @map("created_event_id") @db.Uuid
  latestStatusEventId   String?  @map("latest_status_event_id") @db.Uuid
  sourceOccurredAt      DateTime @map("source_occurred_at") @db.Timestamptz(6)
  latestStatusChangedAt DateTime? @map("latest_status_changed_at") @db.Timestamptz(6)
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@id([tenantId, serviceRequestId])
  @@index([tenantId, requesterId], map: "idx_service_request_snapshots_requester")
  @@map("service_request_snapshots")
}

model PendingNotificationDelivery {
  sourceEventId     String                   @map("source_event_id") @db.Uuid
  consumer          String                   @db.VarChar(100)
  userId            String                   @map("user_id") @db.Uuid
  customerId        String?                  @map("customer_id") @db.Uuid
  channel           String                   @db.VarChar(20)
  status            String                   @default("PENDING") @db.VarChar(20)
  attempts          Int                      @default(0)
  nextAttemptAt     DateTime                 @default(now()) @map("next_attempt_at") @db.Timestamptz(6)
  lastErrorCategory String?                  @map("last_error_category") @db.VarChar(80)
  leaseUntil        DateTime?                @map("lease_until") @db.Timestamptz(6)
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @map("updated_at") @db.Timestamptz(6)
  completedAt       DateTime?                @map("completed_at") @db.Timestamptz(6)
  event             PendingNotificationEvent @relation(fields: [sourceEventId, consumer], references: [sourceEventId, consumer], onDelete: Cascade, onUpdate: NoAction)

  @@id([sourceEventId, consumer, userId, channel])
  @@map("pending_notification_deliveries")
}

model NotificationEventConflict {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceEventId  String    @map("source_event_id") @db.Uuid
  consumer       String    @db.VarChar(100)
  expectedSha256 String    @map("expected_sha256") @db.Char(64)
  observedSha256 String    @map("observed_sha256") @db.Char(64)
  eventType      String    @map("event_type") @db.VarChar(100)
  detectedAt     DateTime  @default(now()) @map("detected_at") @db.Timestamptz(6)
  state          String    @default("OPEN") @db.VarChar(20)
  resolvedAt     DateTime? @map("resolved_at") @db.Timestamptz(6)
  resolvedBy     String?   @map("resolved_by") @db.Uuid

  @@index([state, detectedAt], map: "idx_notification_event_conflicts_state")
  @@unique([sourceEventId, consumer, expectedSha256, observedSha256], map: "uq_notification_event_conflict_hashes")
  @@map("notification_event_conflicts")
}

/// Inbox for idempotent event consumers.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}
