// Identity Service — identity_db
//
// Source of truth for the table structure is the SQL migration
// prisma/migrations/0001_init (copied from docs/erd/pbl6-schema-v3.1.sql).
// This file mirrors it for the Prisma Client. Objects Prisma cannot express
// (CHECK constraints, expression/partial indexes, triggers) live only in the
// migration; see prisma/README.md before changing anything here.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Fixed RBAC role catalog, seeded by migration. Tenants cannot change it.
/// user_type: PLATFORM_STAFF | TENANT_STAFF | CUSTOMER (CHECK in migration).
model Role {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(50)
  name        String           @db.VarChar(100)
  description String?
  userType    String           @map("user_type") @db.VarChar(20)
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  permissions RolePermission[]
  userRoles   UserRole[]

  @@map("roles")
}

/// Fixed permission catalog, seeded by prisma/seed (catalog not yet approved).
model Permission {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code        String           @unique @db.VarChar(100)
  name        String           @db.VarChar(100)
  description String?
  roles       RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@id([roleId, permissionId])
  @@index([permissionId], map: "idx_role_permissions_permission")
  @@map("role_permissions")
}

/// Unique email per tenant / per platform scope is enforced by the
/// expression indexes uq_users_tenant_email and uq_users_platform_email
/// (lower(email)) in the migration. status: INVITED | ACTIVE | SUSPENDED | DISABLED.
model User {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Logical reference to organization_db.tenants.id; NULL for PLATFORM_STAFF.
  tenantId      String?           @map("tenant_id") @db.Uuid
  userType      String            @map("user_type") @db.VarChar(20)
  email         String            @db.VarChar(255)
  /// NULL only while status is INVITED or DISABLED (CHECK in migration).
  passwordHash  String?           @map("password_hash") @db.VarChar(255)
  fullName      String            @map("full_name") @db.VarChar(150)
  phone         String?           @db.VarChar(30)
  status        String            @default("INVITED") @db.VarChar(30)
  lastLoginAt   DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime          @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  roles         UserRole[]        @relation("UserRoleUser")
  assignedRoles UserRole[]        @relation("UserRoleAssignedBy")
  sessions      AuthSession[]
  accountTokens AccountToken[]
  customerLink  UserCustomerLink?

  @@index([tenantId, status], map: "idx_users_tenant_status")
  @@map("users")
}

/// A trigger rejects roles whose user_type differs from the account's.
model UserRole {
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  assignedBy String?  @map("assigned_by") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz(6)
  user       User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  assigner   User?    @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@id([userId, roleId])
  @@index([roleId], map: "idx_user_roles_role")
  @@map("user_roles")
}

/// One row per refresh token. Active-session lookups use the partial index
/// idx_auth_sessions_user_active (WHERE revoked_at IS NULL) from the migration.
model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @unique @map("refresh_token_hash") @db.VarChar(255)
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  ipAddress        String?   @map("ip_address") @db.VarChar(64)
  userAgent        String?   @map("user_agent")
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("auth_sessions")
}

/// purpose: ACCOUNT_ACTIVATION | PASSWORD_RESET | EMAIL_VERIFICATION.
model AccountToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  purpose   String    @db.VarChar(30)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([userId, purpose, expiresAt], map: "idx_account_tokens_user_purpose")
  @@map("account_tokens")
}

/// Local read model of tenants fed by Organization Service events.
/// status: ACTIVE | SUSPENDED | DISABLED.
model TenantDirectory {
  tenantId String   @id @map("tenant_id") @db.Uuid
  code     String   @unique @db.VarChar(50)
  status   String   @db.VarChar(30)
  syncedAt DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)

  @@map("tenant_directory")
}

/// Local read model of organization_db.customer_user_memberships (ADR 0003),
/// fed by CustomerMembershipChanged. Source of the `customer_id` token claim.
/// A trigger (migration 0002) only accepts CUSTOMER accounts of the same tenant.
/// status: ACTIVE | INACTIVE (CHECK in migration).
model UserCustomerLink {
  userId          String   @id @map("user_id") @db.Uuid
  /// Logical reference to organization_db.tenants.id.
  tenantId        String   @map("tenant_id") @db.Uuid
  /// Logical reference to organization_db.customers.id.
  customerId      String   @map("customer_id") @db.Uuid
  /// Logical reference to organization_db.customer_user_memberships.id.
  membershipId    String   @map("membership_id") @db.Uuid
  status          String   @db.VarChar(30)
  /// Membership updated_at in Organization; older events are ignored.
  sourceChangedAt DateTime @map("source_changed_at") @db.Timestamptz(6)
  syncedAt        DateTime @default(now()) @map("synced_at") @db.Timestamptz(6)
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([tenantId, customerId], map: "idx_user_customer_links_customer")
  @@map("user_customer_links")
}

/// Inbox for idempotent event consumers.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}
