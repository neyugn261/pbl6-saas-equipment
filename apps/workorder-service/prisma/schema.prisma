// Work Order Service — workorder_db (also owns technician profiles)
//
// Source of truth for the table structure is prisma/migrations/0001_init
// (copied from docs/erd/pbl6-schema-v3.1.sql).
// This file mirrors it for the Prisma Client. Partial unique indexes and CHECK
// constraints live only in the migration; see prisma/README.md before
// changing anything here.
//
// service_request_id, maintenance_task_id, equipment_id, customer_*, branch_id
// and user ids are logical references to other services and are validated by
// the service layer.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Concurrency-safe per-tenant display numbers (e.g. sequence_key 'WO-2026').
model DocumentSequence {
  tenantId    String @map("tenant_id") @db.Uuid
  sequenceKey String @map("sequence_key") @db.VarChar(50)
  lastValue   BigInt @map("last_value")

  @@id([tenantId, sequenceKey])
  @@map("document_sequences")
}

/// user_id is a TENANT_STAFF account holding the TECHNICIAN role (validated via Identity API).
/// status: AVAILABLE | BUSY | OFF_DUTY | INACTIVE.
model Technician {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  userId         String                @map("user_id") @db.Uuid
  /// Logical reference to organization_db.branches.id
  branchId       String                @map("branch_id") @db.Uuid
  employeeCode   String                @map("employee_code") @db.VarChar(50)
  status         String                @default("AVAILABLE") @db.VarChar(30)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  skills         TechnicianSkill[]
  assignments    WorkOrderAssignment[]
  workLogs       WorkLog[]
  serviceReports ServiceReport[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status], map: "idx_technicians_tenant_branch_status")
  @@map("technicians")
}

model Skill {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  code        String            @db.VarChar(50)
  name        String            @db.VarChar(100)
  description String?
  technicians TechnicianSkill[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("skills")
}

/// level 1-5 (CHECK in SQL).
model TechnicianSkill {
  tenantId     String     @map("tenant_id") @db.Uuid
  technicianId String     @map("technician_id") @db.Uuid
  skillId      String     @map("skill_id") @db.Uuid
  level        Int?       @db.SmallInt
  technician   Technician @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  skill        Skill      @relation(fields: [tenantId, skillId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([technicianId, skillId])
  @@index([tenantId, skillId], map: "idx_technician_skills_skill")
  @@map("technician_skills")
}

/// Exactly one of service_request_id / maintenance_task_id is set (CHECK in SQL).
/// Partial unique indexes in SQL: one non-terminal Work Order per Service
/// Request, one Work Order per Maintenance Task.
/// type: REPAIR | WARRANTY | MAINTENANCE | INSPECTION. priority: LOW | NORMAL | HIGH | URGENT.
/// status: CREATED | ASSIGNED | ACCEPTED | TRAVELLING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED.
model WorkOrder {
  id                String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId          String                   @map("tenant_id") @db.Uuid
  workOrderNo       String                   @map("work_order_no") @db.VarChar(50)
  /// Logical reference to service_request_db.service_requests.id
  serviceRequestId  String?                  @map("service_request_id") @db.Uuid
  /// Logical reference to maintenance_db.maintenance_tasks.id
  maintenanceTaskId String?                  @map("maintenance_task_id") @db.Uuid
  /// Logical reference to asset_db.equipments.id
  equipmentId       String                   @map("equipment_id") @db.Uuid
  /// Logical reference to organization_db.customers.id
  customerId        String                   @map("customer_id") @db.Uuid
  /// Logical reference to organization_db.customer_sites.id
  customerSiteId    String?                  @map("customer_site_id") @db.Uuid
  /// Logical reference to organization_db.locations.id
  locationId        String?                  @map("location_id") @db.Uuid
  type              String                   @db.VarChar(30)
  title             String                   @db.VarChar(200)
  description       String?
  priority          String                   @default("NORMAL") @db.VarChar(20)
  scheduledStart    DateTime?                @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd      DateTime?                @map("scheduled_end") @db.Timestamptz(6)
  status            String                   @default("CREATED") @db.VarChar(30)
  /// Logical reference to identity_db.users.id
  createdBy         String                   @map("created_by") @db.Uuid
  createdAt         DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime                 @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt         DateTime?                @map("started_at") @db.Timestamptz(6)
  completedAt       DateTime?                @map("completed_at") @db.Timestamptz(6)
  cancelledAt       DateTime?                @map("cancelled_at") @db.Timestamptz(6)
  statusHistory     WorkOrderStatusHistory[]
  assignments       WorkOrderAssignment[]
  workLogs          WorkLog[]
  attachments       WorkOrderAttachment[]
  /// At most one row: service_reports.work_order_id is UNIQUE in SQL. Modelled
  /// as a list because the composite FK (tenant_id, work_order_id) is not itself
  /// unique, which Prisma requires for a 1:1 relation.
  serviceReports    ServiceReport[]

  @@unique([tenantId, workOrderNo])
  @@unique([tenantId, id])
  @@index([tenantId, status], map: "idx_work_orders_tenant_status")
  @@index([tenantId, scheduledStart], map: "idx_work_orders_tenant_schedule")
  @@index([tenantId, equipmentId], map: "idx_work_orders_equipment")
  @@map("work_orders")
}

model WorkOrderStatusHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  oldStatus   String?   @map("old_status") @db.VarChar(30)
  newStatus   String    @map("new_status") @db.VarChar(30)
  /// Logical reference to identity_db.users.id; NULL when changed by an event.
  changedBy   String?   @map("changed_by") @db.Uuid
  reason      String?
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  workOrder   WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, changedAt], map: "idx_work_order_status_history_order_time")
  @@map("work_order_status_history")
}

/// One active (ASSIGNED/ACCEPTED) assignment per Work Order (partial unique in SQL).
/// status: ASSIGNED | ACCEPTED | REJECTED | REMOVED | COMPLETED.
model WorkOrderAssignment {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  workOrderId     String     @map("work_order_id") @db.Uuid
  technicianId    String     @map("technician_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  assignedBy      String     @map("assigned_by") @db.Uuid
  status          String     @default("ASSIGNED") @db.VarChar(30)
  assignedAt      DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?  @map("rejected_at") @db.Timestamptz(6)
  unassignedAt    DateTime?  @map("unassigned_at") @db.Timestamptz(6)
  rejectionReason String?    @map("rejection_reason")
  workOrder       WorkOrder  @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician      Technician @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, assignedAt(sort: Desc)], map: "idx_assignments_work_order")
  @@index([technicianId, status, assignedAt(sort: Desc)], map: "idx_assignments_technician")
  @@map("work_order_assignments")
}

/// Activity log for any actor (Dispatcher, Service Manager, Technician);
/// technician_id is set only when the actor acts as the assigned technician.
model WorkLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  workOrderId  String      @map("work_order_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  actorUserId  String      @map("actor_user_id") @db.Uuid
  technicianId String?     @map("technician_id") @db.Uuid
  eventType    String      @map("event_type") @db.VarChar(30)
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder    WorkOrder   @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician   Technician? @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, createdAt], map: "idx_work_logs_order_time")
  @@index([tenantId, actorUserId, createdAt(sort: Desc)], map: "idx_work_logs_actor_time")
  @@map("work_logs")
}

model WorkOrderAttachment {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  uploadedBy  String    @map("uploaded_by") @db.Uuid
  storageKey  String    @map("storage_key") @db.VarChar(500)
  fileName    String    @map("file_name") @db.VarChar(255)
  mimeType    String    @map("mime_type") @db.VarChar(100)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder   WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId], map: "idx_work_order_attachments_order")
  @@map("work_order_attachments")
}

/// result: RESOLVED | PARTIALLY_RESOLVED | UNRESOLVED.
model ServiceReport {
  id                 String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String             @map("tenant_id") @db.Uuid
  workOrderId        String             @unique @map("work_order_id") @db.Uuid
  technicianId       String             @map("technician_id") @db.Uuid
  problemDescription String             @map("problem_description")
  rootCause          String?            @map("root_cause")
  solution           String
  result             String             @db.VarChar(30)
  customerNote       String?            @map("customer_note")
  submittedAt        DateTime           @default(now()) @map("submitted_at") @db.Timestamptz(6)
  workOrder          WorkOrder          @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician         Technician         @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  attachments        ReportAttachment[]

  @@unique([tenantId, id])
  @@index([tenantId, technicianId, submittedAt(sort: Desc)], map: "idx_service_reports_technician_time")
  @@map("service_reports")
}

model ReportAttachment {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  serviceReportId String        @map("service_report_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  uploadedBy      String        @map("uploaded_by") @db.Uuid
  storageKey      String        @map("storage_key") @db.VarChar(500)
  fileName        String        @map("file_name") @db.VarChar(255)
  mimeType        String        @map("mime_type") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  serviceReport   ServiceReport @relation(fields: [tenantId, serviceReportId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([serviceReportId], map: "idx_report_attachments_report")
  @@map("report_attachments")
}

/// Transactional outbox; id is the event id sent to consumers.
/// status: PENDING | PUBLISHED | FAILED.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  eventVersion  Int       @default(1) @map("event_version") @db.SmallInt
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

/// Inbox for idempotent event consumers.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}
