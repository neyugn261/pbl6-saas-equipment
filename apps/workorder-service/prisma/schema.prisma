// Work Order Service — workorder_db (also owns technician profiles)
//
// Source of truth for the table structure is prisma/migrations/0001_init
// (copied from docs/erd/pbl6-schema-v3.1.sql, including the ADR 0002 fix).
// This file mirrors it for the Prisma Client. Partial unique indexes and CHECK
// constraints live only in the migration; see prisma/README.md before
// changing anything here.
//
// service_request_id, maintenance_task_id, equipment_id, customer_*, branch_id
// and user ids are logical references to other services and are validated by
// the service layer.

generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

/// Concurrency-safe per-tenant display numbers (e.g. sequence_key 'WO-2026').
model DocumentSequence {
  tenantId    String @map("tenant_id") @db.Uuid
  sequenceKey String @map("sequence_key") @db.VarChar(50)
  lastValue   BigInt @map("last_value")

  @@id([tenantId, sequenceKey])
  @@map("document_sequences")
}

/// user_id is a TENANT_STAFF account holding the TECHNICIAN role (validated via Identity API).
/// status: AVAILABLE | BUSY | OFF_DUTY | INACTIVE.
model Technician {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                @map("tenant_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  userId         String                @map("user_id") @db.Uuid
  /// Logical reference to organization_db.branches.id
  branchId       String                @map("branch_id") @db.Uuid
  employeeCode   String                @map("employee_code") @db.VarChar(50)
  status         String                @default("AVAILABLE") @db.VarChar(30)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  skills         TechnicianSkill[]
  assignments    WorkOrderAssignment[]
  workLogs       WorkLog[]
  serviceReports ServiceReport[]

  @@unique([tenantId, employeeCode])
  @@unique([tenantId, userId])
  @@unique([tenantId, id])
  @@index([tenantId, branchId, status], map: "idx_technicians_tenant_branch_status")
  @@map("technicians")
}

model Skill {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  code        String            @db.VarChar(50)
  name        String            @db.VarChar(100)
  description String?
  technicians TechnicianSkill[]

  @@unique([tenantId, code])
  @@unique([tenantId, id])
  @@map("skills")
}

/// level 1-5 (CHECK in SQL).
model TechnicianSkill {
  tenantId     String     @map("tenant_id") @db.Uuid
  technicianId String     @map("technician_id") @db.Uuid
  skillId      String     @map("skill_id") @db.Uuid
  level        Int?       @db.SmallInt
  technician   Technician @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)
  skill        Skill      @relation(fields: [tenantId, skillId], references: [tenantId, id], onDelete: Cascade, onUpdate: NoAction)

  @@id([technicianId, skillId])
  @@index([tenantId, skillId], map: "idx_technician_skills_skill")
  @@map("technician_skills")
}

/// Exactly one of service_request_id / maintenance_task_id is set (CHECK in SQL).
/// Partial unique indexes in SQL: one non-terminal Work Order per Service
/// Request, one non-cancelled Work Order per Maintenance Task (ADR 0002).
/// type: REPAIR | WARRANTY | MAINTENANCE | INSPECTION. priority: LOW | NORMAL | HIGH | URGENT.
/// status: CREATED | ASSIGNED | ACCEPTED | TRAVELLING | IN_PROGRESS | ON_HOLD | COMPLETED | CANCELLED.
model WorkOrder {
  /// NULL means unallocated legacy/central queue, never unrestricted branch access.
  branchId                        String?                         @map("branch_id") @db.Uuid
  checklistHistory                WorkOrderChecklistHistory[]
  checklist                       Json?
  checklistResults                Json?                           @map("checklist_results")
  checklistVersion                Int                             @default(0) @map("checklist_version")
  policyVersionId                 String?                         @map("policy_version_id") @db.Uuid
  id                              String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId                        String                          @map("tenant_id") @db.Uuid
  workOrderNo                     String                          @map("work_order_no") @db.VarChar(50)
  /// Logical reference to service_request_db.service_requests.id
  serviceRequestId                String?                         @map("service_request_id") @db.Uuid
  /// Logical reference to maintenance_db.maintenance_tasks.id
  maintenanceTaskId               String?                         @map("maintenance_task_id") @db.Uuid
  /// Stable request from Maintenance; retained after cancellation for business deduplication.
  maintenanceReplacementRequestId String?                         @unique(map: "uq_work_orders_maintenance_replacement_request") @map("maintenance_replacement_request_id") @db.Uuid
  /// Previous WO in this database; source/tenant validated by the consumer. A WO has at most one successor.
  replacesWorkOrderId             String?                         @unique(map: "uq_work_orders_replaces_work_order") @map("replaces_work_order_id") @db.Uuid
  /// Logical reference to asset_db.equipments.id
  equipmentId                     String                          @map("equipment_id") @db.Uuid
  /// Logical reference to organization_db.customers.id
  customerId                      String                          @map("customer_id") @db.Uuid
  /// Logical reference to organization_db.customer_sites.id
  customerSiteId                  String?                         @map("customer_site_id") @db.Uuid
  /// Logical reference to organization_db.locations.id
  locationId                      String?                         @map("location_id") @db.Uuid
  type                            String                          @db.VarChar(30)
  title                           String                          @db.VarChar(200)
  description                     String?
  priority                        String                          @default("NORMAL") @db.VarChar(20)
  scheduledStart                  DateTime?                       @map("scheduled_start") @db.Timestamptz(6)
  scheduledEnd                    DateTime?                       @map("scheduled_end") @db.Timestamptz(6)
  status                          String                          @default("CREATED") @db.VarChar(30)
  /// Logical reference to identity_db.users.id. NULL = created by the system
  /// from an event (ADR 0008, D5).
  createdBy                       String?                         @map("created_by") @db.Uuid
  createdAt                       DateTime                        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                       DateTime                        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  startedAt                       DateTime?                       @map("started_at") @db.Timestamptz(6)
  completedAt                     DateTime?                       @map("completed_at") @db.Timestamptz(6)
  cancelledAt                     DateTime?                       @map("cancelled_at") @db.Timestamptz(6)
  statusHistory                   WorkOrderStatusHistory[]
  assignments                     WorkOrderAssignment[]
  workLogs                        WorkLog[]
  attachments                     WorkOrderAttachment[]
  attachmentUploads               AttachmentUploadIntent[]
  inventoryReservations           WorkOrderInventoryReservation[]
  /// At most one row: service_reports.work_order_id is UNIQUE in SQL. Modelled
  /// as a list because the composite FK (tenant_id, work_order_id) is not itself
  /// unique, which Prisma requires for a 1:1 relation.
  serviceReports                  ServiceReport[]

  @@unique([tenantId, workOrderNo])
  @@unique([tenantId, id])
  @@index([tenantId, status], map: "idx_work_orders_tenant_status")
  @@index([tenantId, scheduledStart], map: "idx_work_orders_tenant_schedule")
  @@index([tenantId, equipmentId], map: "idx_work_orders_equipment")
  @@index([tenantId, branchId])
  @@map("work_orders")
}

model WorkOrderStatusHistory {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @map("tenant_id") @db.Uuid
  workOrderId String    @map("work_order_id") @db.Uuid
  oldStatus   String?   @map("old_status") @db.VarChar(30)
  newStatus   String    @map("new_status") @db.VarChar(30)
  /// Logical reference to identity_db.users.id; NULL when changed by an event.
  changedBy   String?   @map("changed_by") @db.Uuid
  reason      String?
  changedAt   DateTime  @default(now()) @map("changed_at") @db.Timestamptz(6)
  workOrder   WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, changedAt], map: "idx_work_order_status_history_order_time")
  @@map("work_order_status_history")
}

/// One active (ASSIGNED/ACCEPTED) assignment per Work Order (partial unique in SQL).
/// status: ASSIGNED | ACCEPTED | REJECTED | REMOVED | COMPLETED.
model WorkOrderAssignment {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @map("tenant_id") @db.Uuid
  workOrderId     String     @map("work_order_id") @db.Uuid
  technicianId    String     @map("technician_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  assignedBy      String     @map("assigned_by") @db.Uuid
  status          String     @default("ASSIGNED") @db.VarChar(30)
  assignedAt      DateTime   @default(now()) @map("assigned_at") @db.Timestamptz(6)
  acceptedAt      DateTime?  @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?  @map("rejected_at") @db.Timestamptz(6)
  unassignedAt    DateTime?  @map("unassigned_at") @db.Timestamptz(6)
  rejectionReason String?    @map("rejection_reason")
  workOrder       WorkOrder  @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician      Technician @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, assignedAt(sort: Desc)], map: "idx_assignments_work_order")
  @@index([technicianId, status, assignedAt(sort: Desc)], map: "idx_assignments_technician")
  @@map("work_order_assignments")
}

/// Activity log for any actor (Dispatcher, Service Manager, Technician);
/// technician_id is set only when the actor acts as the assigned technician.
model WorkLog {
  id           String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String      @map("tenant_id") @db.Uuid
  workOrderId  String      @map("work_order_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  actorUserId  String      @map("actor_user_id") @db.Uuid
  technicianId String?     @map("technician_id") @db.Uuid
  eventType    String      @map("event_type") @db.VarChar(30)
  note         String?
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  workOrder    WorkOrder   @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician   Technician? @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([workOrderId, createdAt], map: "idx_work_logs_order_time")
  @@index([tenantId, actorUserId, createdAt(sort: Desc)], map: "idx_work_logs_actor_time")
  @@map("work_logs")
}

model WorkOrderAttachment {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  workOrderId         String                   @map("work_order_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  uploadedBy          String                   @map("uploaded_by") @db.Uuid
  storageKey          String                   @map("storage_key") @db.VarChar(500)
  fileName            String                   @map("file_name") @db.VarChar(255)
  mimeType            String                   @map("mime_type") @db.VarChar(100)
  /// INTERNAL | CUSTOMER (ADR 0006); customer accounts only see CUSTOMER.
  visibility          String                   @default("INTERNAL") @db.VarChar(20)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// NULL together for pre-M3 rows; only verified rows may be served by M3 APIs.
  sizeBytes           Int?                     @map("size_bytes")
  checksumSha256      String?                  @map("checksum_sha256") @db.Char(64)
  verifiedAt          DateTime?                @map("verified_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?                  @map("deleted_by") @db.Uuid
  visibilityChangedAt DateTime?                @map("visibility_changed_at") @db.Timestamptz(6)
  visibilityChangedBy String?                  @map("visibility_changed_by") @db.Uuid
  workOrder           WorkOrder                @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  uploadResults       AttachmentUploadIntent[] @relation("WorkOrderUploadResult")

  @@unique([tenantId, workOrderId, id], map: "uq_wo_attachment_parent_id")
  @@index([workOrderId], map: "idx_work_order_attachments_order")
  @@map("work_order_attachments")
}

/// result: RESOLVED | PARTIALLY_RESOLVED | UNRESOLVED.
model ServiceReport {
  id                 String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                   @map("tenant_id") @db.Uuid
  workOrderId        String                   @unique @map("work_order_id") @db.Uuid
  technicianId       String                   @map("technician_id") @db.Uuid
  problemDescription String                   @map("problem_description")
  rootCause          String?                  @map("root_cause")
  solution           String
  result             String                   @db.VarChar(30)
  customerNote       String?                  @map("customer_note")
  unresolvedReason   String?                  @map("unresolved_reason")
  signOffStatus      String                   @default("NOT_APPLICABLE") @map("sign_off_status") @db.VarChar(30)
  signerName         String?                  @map("signer_name") @db.VarChar(100)
  signerTitle        String?                  @map("signer_title") @db.VarChar(100)
  signerPhone        String?                  @map("signer_phone") @db.VarChar(30)
  signedAt           DateTime?                @map("signed_at") @db.Timestamptz(6)
  signatureAttachmentId String?               @map("signature_attachment_id") @db.Uuid
  signOffNotes       String?                  @map("sign_off_notes")
  submittedAt        DateTime                 @default(now()) @map("submitted_at") @db.Timestamptz(6)
  workOrder          WorkOrder                @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  technician         Technician               @relation(fields: [tenantId, technicianId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  attachments        ReportAttachment[]
  attachmentUploads  AttachmentUploadIntent[]

  @@unique([tenantId, id])
  @@unique([tenantId, workOrderId, id], map: "uq_service_report_order_id")
  @@index([tenantId, technicianId, submittedAt(sort: Desc)], map: "idx_service_reports_technician_time")
  @@map("service_reports")
}

model ReportAttachment {
  id                  String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId            String                   @map("tenant_id") @db.Uuid
  serviceReportId     String                   @map("service_report_id") @db.Uuid
  /// Logical reference to identity_db.users.id
  uploadedBy          String                   @map("uploaded_by") @db.Uuid
  storageKey          String                   @map("storage_key") @db.VarChar(500)
  fileName            String                   @map("file_name") @db.VarChar(255)
  mimeType            String                   @map("mime_type") @db.VarChar(100)
  /// INTERNAL | CUSTOMER (ADR 0006); customer accounts only see CUSTOMER.
  visibility          String                   @default("INTERNAL") @db.VarChar(20)
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  /// NULL together for pre-M3 rows; never invent metadata during migration.
  sizeBytes           Int?                     @map("size_bytes")
  checksumSha256      String?                  @map("checksum_sha256") @db.Char(64)
  verifiedAt          DateTime?                @map("verified_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  deletedBy           String?                  @map("deleted_by") @db.Uuid
  visibilityChangedAt DateTime?                @map("visibility_changed_at") @db.Timestamptz(6)
  visibilityChangedBy String?                  @map("visibility_changed_by") @db.Uuid
  serviceReport       ServiceReport            @relation(fields: [tenantId, serviceReportId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  uploadResults       AttachmentUploadIntent[] @relation("ReportUploadResult")

  @@unique([tenantId, serviceReportId, id], map: "uq_report_attachment_parent_id")
  @@index([serviceReportId], map: "idx_report_attachments_report")
  @@map("report_attachments")
}

/// ADR 0013 / M3-A1: persistence only; upload routes and workers follow in A2/A3.
/// State: INITIATED | ATTACHED | EXPIRED | ABORTED. Target: WORK_ORDER | REPORT.
/// All targets have a WO; REPORT also has a tenant-and-WO-safe report FK.
model AttachmentUploadIntent {
  id                    String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId              String                  @map("tenant_id") @db.Uuid
  uploadedBy            String                  @map("uploaded_by") @db.Uuid
  targetType            String                  @map("target_type") @db.VarChar(20)
  workOrderId           String                  @map("work_order_id") @db.Uuid
  serviceReportId       String?                 @map("service_report_id") @db.Uuid
  fileName              String                  @map("file_name") @db.VarChar(255)
  mimeType              String                  @map("mime_type") @db.VarChar(100)
  sizeBytes             Int                     @map("size_bytes")
  checksumSha256        String                  @map("checksum_sha256") @db.Char(64)
  visibility            String                  @default("INTERNAL") @db.VarChar(20)
  stagingKey            String                  @unique(map: "uq_attachment_upload_staging_key") @map("staging_key") @db.VarChar(500)
  status                String                  @default("INITIATED") @db.VarChar(20)
  expiresAt             DateTime                @map("expires_at") @db.Timestamptz(6)
  /// A fenced attempt; lease expiry cannot authorize a stale finalizer to commit.
  attemptId             String?                 @map("attempt_id") @db.Uuid
  attemptFinalKey       String?                 @map("attempt_final_key") @db.VarChar(500)
  leaseExpiresAt        DateTime?               @map("lease_expires_at") @db.Timestamptz(6)
  workOrderAttachmentId String?                 @unique(map: "uq_attachment_upload_wo_result") @map("work_order_attachment_id") @db.Uuid
  reportAttachmentId    String?                 @unique(map: "uq_attachment_upload_report_result") @map("report_attachment_id") @db.Uuid
  attachedAt            DateTime?               @map("attached_at") @db.Timestamptz(6)
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  workOrder             WorkOrder               @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  serviceReport         ServiceReport?          @relation(fields: [tenantId, workOrderId, serviceReportId], references: [tenantId, workOrderId, id], onDelete: Restrict, onUpdate: NoAction)
  workOrderAttachment   WorkOrderAttachment?    @relation("WorkOrderUploadResult", fields: [tenantId, workOrderId, workOrderAttachmentId], references: [tenantId, workOrderId, id], onDelete: Restrict, onUpdate: NoAction)
  reportAttachment      ReportAttachment?       @relation("ReportUploadResult", fields: [tenantId, serviceReportId, reportAttachmentId], references: [tenantId, serviceReportId, id], onDelete: Restrict, onUpdate: NoAction)
  idempotencyRecords    AttachmentIdempotency[]
  cleanupJobs           AttachmentCleanupJob[]

  @@unique([tenantId, id], map: "uq_attachment_upload_tenant_id")
  @@unique([tenantId, uploadedBy, id], map: "uq_attachment_upload_actor_id")
  @@index([tenantId, workOrderId, targetType, status, expiresAt], map: "idx_attachment_upload_quota")
  @@index([status, expiresAt], map: "idx_attachment_upload_expiry")
  @@map("attachment_upload_intents")
}

/// PREPARE spans both target types; changing parent with the same key conflicts.
/// Store references/fingerprints, never signed URLs or raw response bodies.
model AttachmentIdempotency {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String                 @map("tenant_id") @db.Uuid
  userId      String                 @map("user_id") @db.Uuid
  operation   String                 @db.VarChar(20)
  key         String                 @db.Uuid
  fingerprint String                 @db.Char(64)
  uploadId    String                 @map("upload_id") @db.Uuid
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  upload      AttachmentUploadIntent @relation(fields: [tenantId, userId, uploadId], references: [tenantId, uploadedBy, id], onDelete: Restrict, onUpdate: NoAction)

  @@unique([tenantId, userId, operation, key], map: "uq_attachment_idempotency_scope")
  @@index([tenantId, uploadId], map: "idx_attachment_idempotency_upload")
  @@map("attachment_idempotency")
}

/// One durable record per object, registered before storage writes. A DONE job
/// may be requeued by deletion/reconciliation; DONE is not a purge instruction.
model AttachmentCleanupJob {
  id             String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String                 @map("tenant_id") @db.Uuid
  uploadId       String                 @map("upload_id") @db.Uuid
  kind           String                 @db.VarChar(20)
  objectKey      String                 @unique(map: "uq_attachment_cleanup_object") @map("object_key") @db.VarChar(500)
  attemptId      String?                @map("attempt_id") @db.Uuid
  status         String                 @default("PENDING") @db.VarChar(20)
  notBefore      DateTime               @map("not_before") @db.Timestamptz(6)
  attemptCount   Int                    @default(0) @map("attempt_count")
  claimId        String?                @map("claim_id") @db.Uuid
  leaseExpiresAt DateTime?              @map("lease_expires_at") @db.Timestamptz(6)
  lastErrorCode  String?                @map("last_error_code") @db.VarChar(80)
  completedAt    DateTime?              @map("completed_at") @db.Timestamptz(6)
  createdAt      DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime               @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  upload         AttachmentUploadIntent @relation(fields: [tenantId, uploadId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([status, notBefore, leaseExpiresAt], map: "idx_attachment_cleanup_ready")
  @@index([tenantId, uploadId], map: "idx_attachment_cleanup_upload")
  @@map("attachment_cleanup_jobs")
}

/// Transactional outbox; id is the event id sent to consumers.
/// status: PENDING | PUBLISHED | FAILED.
model OutboxEvent {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String?   @map("tenant_id") @db.Uuid
  aggregateType String    @map("aggregate_type") @db.VarChar(50)
  aggregateId   String    @map("aggregate_id") @db.Uuid
  eventType     String    @map("event_type") @db.VarChar(100)
  eventVersion  Int       @default(1) @map("event_version") @db.SmallInt
  payload       Json
  status        String    @default("PENDING") @db.VarChar(20)
  attemptCount  Int       @default(0) @map("attempt_count")
  lastError     String?   @map("last_error")
  availableAt   DateTime  @default(now()) @map("available_at") @db.Timestamptz(6)
  occurredAt    DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(6)
  publishedAt   DateTime? @map("published_at") @db.Timestamptz(6)

  @@map("outbox_events")
}

/// Inbox for idempotent event consumers.
model ProcessedEvent {
  eventId     String   @map("event_id") @db.Uuid
  consumer    String   @db.VarChar(100)
  eventType   String   @map("event_type") @db.VarChar(100)
  processedAt DateTime @default(now()) @map("processed_at") @db.Timestamptz(6)

  @@id([eventId, consumer])
  @@map("processed_events")
}

/// ADR 0014 / 0016. Logical references to Inventory, never a cross-DB FK.
/// No automatic expiry. COMMITTED/RELEASED are immutable terminal outcomes.
model WorkOrderInventoryReservation {
  tenantId           String    @map("tenant_id") @db.Uuid
  requestId          String    @map("request_id") @db.Uuid
  workOrderId        String    @map("work_order_id") @db.Uuid
  fingerprint        String    @db.Char(64)
  actorId            String    @map("actor_id") @db.Uuid
  inventoryRequest   Json      @map("inventory_request")
  state              String    @db.VarChar(20)
  inventoryUsageId   String?   @map("inventory_usage_id") @db.Uuid
  stockTransactionId String?   @map("stock_transaction_id") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  settledAt          DateTime? @map("settled_at") @db.Timestamptz(6)
  workOrder          WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction, map: "fk_wo_inventory_reservation_order")

  @@id([tenantId, requestId])
  @@unique([tenantId, inventoryUsageId], map: "uq_wo_inventory_reservation_usage")
  @@unique([tenantId, stockTransactionId], map: "uq_wo_inventory_reservation_transaction")
  @@index([tenantId, workOrderId, state], map: "idx_wo_inventory_reservation_held")
  @@map("work_order_inventory_reservations")
}

model WorkOrderChecklistHistory {
  workOrder    WorkOrder @relation(fields: [tenantId, workOrderId], references: [tenantId, id], onDelete: Restrict, onUpdate: NoAction)
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  workOrderId  String    @map("work_order_id") @db.Uuid
  actorId      String    @map("actor_id") @db.Uuid
  assignmentId String    @map("assignment_id") @db.Uuid
  version      Int
  results      Json
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([tenantId, workOrderId, version])
  @@map("work_order_checklist_history")
}

model SiteBranchSnapshot {
  tenantId String  @map("tenant_id") @db.Uuid
  siteId   String  @map("site_id") @db.Uuid
  branchId String? @map("branch_id") @db.Uuid
  revision Int

  @@id([tenantId, siteId])
  @@map("site_branch_snapshots")
}
